<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.7.0.0</Version><Author>MTitan</Author><Name>Sentinel Hub</Name>
    <Punchline>Optional Sentinel ecosystem control center.</Punchline>
    <Description>Sentinel ecosystem control center with passive Mount and Fashion Accessories collections, shared player identification, opt-in Anti-AFK, Quest Convenience and bounded instant-action latency compensation. HUD visuals and other Sentinel plugins remain independent.</Description>
    <RepoUrl>https://github.com/MarshalTitan/SentinelHub</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/MarshalTitan/SentinelHub/main/assets/icon.png</IconUrl>
    <Tags>sentinel;utility;diagnostics</Tags><AllowUnsafeBlocks>true</AllowUnsafeBlocks><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup><Compile Remove="tests/**/*.cs;.fixtures/**/*.cs" /><None Include="assets/icon.png" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><PackageReference Include="MarshalTitan.SentinelCore" Version="[0.4.1]" /><PackageReference Include="MarshalTitan.SentinelCore.UI" Version="[0.4.1]" /></ItemGroup>
<ItemGroup><EmbeddedResource Include="Mounts/Data/Acquisition.json" LogicalName="SentinelHub.MountSources.json"/><EmbeddedResource Include="Mounts/Data/StoreLinks.json" LogicalName="SentinelHub.MountStoreLinks.json"/></ItemGroup>
<ItemGroup><EmbeddedResource Include="Fashion/Data/Acquisition.json" LogicalName="SentinelHub.FashionSources.json"/><EmbeddedResource Include="Fashion/Data/Corrections.json" LogicalName="SentinelHub.FashionCorrections.json"/></ItemGroup>
<ItemGroup><AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute"><_Parameter1>SentinelHub.UiTests</_Parameter1></AssemblyAttribute></ItemGroup>
<ItemGroup><EmbeddedResource Include="Inspection/Data/Emotes.json" LogicalName="SentinelHub.InspectionEmotes.json"/><EmbeddedResource Include="Inspection/Data/Bardings.json" LogicalName="SentinelHub.InspectionBardings.json"/></ItemGroup></Project>

